ROUTEWISE_ENV=dev
ROUTEWISE_LOG_LEVEL=INFO
ROUTEWISE_LOG_JSON=false

ROUTEWISE_LLM_PROVIDER=groq
ROUTEWISE_GROQ_API_KEYS=your_key_1,your_key_2
ROUTEWISE_GROQ_BASE_URL=https://api.groq.com/openai/v1
ROUTEWISE_GROQ_REASONING_EFFORT=low

ROUTEWISE_SMALL_MODEL=openai/gpt-oss-20b
ROUTEWISE_LARGE_MODEL=openai/gpt-oss-120b
ROUTEWISE_REQUEST_TIMEOUT_S=60
ROUTEWISE_LLM_MAX_RETRIES=3
ROUTEWISE_LLM_RETRY_BACKOFF_S=0.5

ROUTEWISE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ROUTEWISE_CACHE_SIMILARITY_THRESHOLD=0.85
ROUTEWISE_CACHE_TTL_S=86400
ROUTEWISE_CACHE_MAX_ENTRIES=10000

ROUTEWISE_ROUTER_THRESHOLD=0.30
ROUTEWISE_ROUTER_PRESSURE_WEIGHT=0.20

ROUTEWISE_DB_PATH=data/routewise.db

ROUTEWISE_BUDGET_USD=1.0
ROUTEWISE_BUDGET_WINDOW_S=3600

ROUTEWISE_GATEWAY_API_KEY=
ROUTEWISE_STORE_QUERIES=true
